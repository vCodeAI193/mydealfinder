# ──────────────────────────────────────────────────────────────────────────
# MyDealFinder environment configuration.
# Copy this file to `.env` and adjust as needed: `cp .env.example .env`
# docker-compose reads this file automatically.
# ──────────────────────────────────────────────────────────────────────────

# --- PostgreSQL (used by docker-compose to provision the database) ---
POSTGRES_USER=mydealfinder
POSTGRES_PASSWORD=mydealfinder
POSTGRES_DB=mydealfinder

# --- Backend ---
# Async SQLAlchemy DSN. In docker-compose this points at the `db` service.
# For local (non-Docker) dev you can leave it on SQLite (see backend default).
DATABASE_URL=postgresql+asyncpg://mydealfinder:mydealfinder@db:5432/mydealfinder

# Optional Redis cache. Leave empty to disable caching. F085/F086.
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=60

# Ops/automation. LOG_LEVEL (F082), metrics (F083), scheduler (F084/F046).
LOG_LEVEL=INFO
ENABLE_METRICS=true
SCHEDULER_ENABLED=true
REFRESH_INTERVAL_SECONDS=3600
ALERT_CHECK_INTERVAL_SECONDS=300

# Comma-separated list of origins allowed to call the API (the frontend).
CORS_ORIGINS=http://localhost:3000

# Seed demo products + price history on first startup (true/false).
SEED_ON_STARTUP=true

# F079-F081: comma-separated emails granted admin access (dashboard/flags/audit).
ADMIN_EMAILS=

# Enable verbose SQL / debug logging (true/false).
DEBUG=false

# Feature flags (see FEATURES.md).
# F001: tolerate small typos in search queries.
FUZZY_SEARCH=false
# F045: which sources to query (comma-separated). Empty = all.
# Add "demoapi" to include the real HTTP/JSON source (F044).
ENABLED_SOURCES=amazon,ebay,walmart
# F047: per-source rate limit (requests/minute). 0 = unlimited.
SOURCE_RATE_LIMIT_PER_MINUTE=0
# F050: extra HTTP sources as a JSON array (no code changes needed).
CUSTOM_SOURCES=
# F025: max open alerts per (email, product). 0 = unlimited.
MAX_ALERTS_PER_PRODUCT=0
# F011: rank/compare offers by shipping-inclusive total price.
TRUE_PRICE=false
# F014: show per-source trust ratings.
SHOW_SOURCE_RATINGS=false
# F015: show coupon/voucher codes on offers.
SHOW_COUPONS=false
# F036: allow using the app without an account.
ALLOW_GUEST=true
# F042: allow users to export all their data.
ENABLE_DATA_EXPORT=true
# F043: allow users to delete their own account.
ENABLE_ACCOUNT_DELETION=true

# F028: SMTP for real alert emails. Leave SMTP_HOST empty to log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@mydealfinder.local
SMTP_USE_TLS=true

# --- Frontend ---
# Base URL the browser uses to reach the backend API.
NEXT_PUBLIC_API_URL=http://localhost:8000
