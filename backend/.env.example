# Backend-only environment variables (for running the API standalone).
# Copy to `.env`: `cp .env.example .env`

# Async SQLAlchemy DSN. Defaults to a local SQLite file when unset.
# Postgres example: postgresql+asyncpg://user:pass@localhost:5432/mydealfinder
DATABASE_URL=sqlite+aiosqlite:///./mydealfinder.db

# Optional Redis cache (leave empty to disable). F085/F086.
REDIS_URL=
CACHE_TTL_SECONDS=60

# Ops/automation. LOG_LEVEL (F082), metrics (F083), scheduler (F084/F046).
LOG_LEVEL=INFO
ENABLE_METRICS=true
SCHEDULER_ENABLED=false
REFRESH_INTERVAL_SECONDS=0
ALERT_CHECK_INTERVAL_SECONDS=0

# Origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Seed demo data on first startup.
SEED_ON_STARTUP=true

# F079-F081: comma-separated emails granted admin access (dashboard/flags/audit).
ADMIN_EMAILS=

# Verbose SQL logging.
DEBUG=false

# --- Feature flags ---
# F001: tolerate small typos in search queries (true/false).
FUZZY_SEARCH=false
# F045: which sources to query (comma-separated). Empty = all.
# Add "demoapi" to include the real HTTP/JSON source (F044).
ENABLED_SOURCES=amazon,ebay,walmart
# F047: per-source rate limit (requests/minute). 0 = unlimited.
SOURCE_RATE_LIMIT_PER_MINUTE=0
# F050: extra HTTP sources as a JSON array (no code changes needed), e.g.
# [{"name":"myapi","url_template":"https://x/search?q={query}","results_path":"products"}]
CUSTOM_SOURCES=
# F025: max open alerts per (email, product). 0 = unlimited.
MAX_ALERTS_PER_PRODUCT=0
# F011: rank/compare offers by shipping-inclusive total price.
TRUE_PRICE=false
# F014: show per-source trust ratings.
SHOW_SOURCE_RATINGS=false
# F015: show coupon/voucher codes on offers.
SHOW_COUPONS=false
# F036: allow using the app without an account.
ALLOW_GUEST=true
# F042: allow users to export all their data.
ENABLE_DATA_EXPORT=true
# F043: allow users to delete their own account.
ENABLE_ACCOUNT_DELETION=true

# F028: SMTP for real alert emails. Leave SMTP_HOST empty to log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@mydealfinder.local
SMTP_USE_TLS=true
